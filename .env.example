# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/blogspace or MongoDB Atlas URI)
# If left unset, the backend will seamlessly use an embedded persisted JSON document store.
MONGODB_URI=""

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication
JWT_SECRET="blogspace_super_secret_jwt_key_2026"

# PORT: The server port (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Optional key for AI blog writing assistant features
GEMINI_API_KEY=""

